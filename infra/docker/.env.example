# Local development secrets for infra/docker/docker-compose.yml.
#
#   cp .env.example .env      # .env is git-ignored
#   then replace every "change-me" value with your own random value (e.g. `openssl rand -hex 24`)
#
# The same file is read by the services' "local" Spring profile (spring.config.import), so a
# service and its database always agree on the password. Never commit .env.

# Administrative superusers of the containers
POSTGRES_ADMIN_USER=foodflow_admin
POSTGRES_ADMIN_PASSWORD=change-me
MONGO_ROOT_USER=foodflow_admin
MONGO_ROOT_PASSWORD=change-me

# One credential per service database (database-per-service)
USER_DB_PASSWORD=change-me
RESTAURANT_DB_PASSWORD=change-me
ORDER_DB_PASSWORD=change-me
PAYMENT_DB_PASSWORD=change-me
DELIVERY_DB_PASSWORD=change-me
MENU_DB_PASSWORD=change-me
NOTIFICATION_DB_PASSWORD=change-me
