<?xml version="1.0" encoding="UTF-8"?>
<!--
  FoodFlow event contracts (ADR-0005).

  Avro schemas in src/main/avro are the source of truth for every Kafka event. Java classes are
  generated at build time. Schemas must evolve BACKWARD-compatibly (new fields need defaults);
  a breaking change requires a new topic version (.v2).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.foodflow</groupId>
        <artifactId>foodflow-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../foodflow-parent/pom.xml</relativePath>
    </parent>

    <artifactId>foodflow-event-contracts</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>foodflow-event-contracts</name>
    <description>Avro schemas and generated classes for FoodFlow domain events</description>

    <dependencies>
        <dependency>
            <groupId>org.apache.avro</groupId>
            <artifactId>avro</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.avro</groupId>
                <artifactId>avro-maven-plugin</artifactId>
                <version>${avro.version}</version>
                <executions>
                    <execution>
                        <id>generate-avro-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>schema</goal>
                        </goals>
                        <configuration>
                            <sourceDirectory>${project.basedir}/src/main/avro</sourceDirectory>
                            <outputDirectory>${project.build.directory}/generated-sources/avro</outputDirectory>
                            <!-- Shared types must be parsed before the schemas that reference them -->
                            <imports>
                                <import>${project.basedir}/src/main/avro/common/EventMetadata.avsc</import>
                            </imports>
                            <stringType>String</stringType>
                            <fieldVisibility>PRIVATE</fieldVisibility>
                            <createSetters>false</createSetters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
