<?xml version="1.0" encoding="UTF-8"?>
<!--
  FoodFlow platform core: framework-neutral building blocks shared by servlet services
  (via foodflow-platform-starter) and the reactive API gateway.
    * UnresolvedPlaceholderGuard: fail fast on undefined configuration variables
    * JwtValidation: issuer + audience rules every resource server applies
    * CorrelationId: header name, MDC key and sanitization rules
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.foodflow</groupId>
        <artifactId>foodflow-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../foodflow-parent/pom.xml</relativePath>
    </parent>

    <artifactId>foodflow-platform-core</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>foodflow-platform-core</name>
    <description>Framework-neutral platform building blocks (servlet and reactive)</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-jose</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
